generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CASHIER
}

enum PaymentMethod {
  CASH
  CARD
  CREDIT
  MIXED
  CUSTOM
}

enum LedgerDirection {
  IN
  OUT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum SalaryType {
  MONTHLY
  DAILY
  HOURLY
}

enum OrderStatus {
  PENDING
  CONFIRMED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELED
  FAILED
}

model Store {
  id        String   @id @default(cuid())
  name      String
  currency  String   @default("so'm")
  phone     String?
  address   String?
  logoUrl   String?
  usdRate   Int?
  showDebtInUsdOnly   Boolean @default(false)
  enableMixedPayment  Boolean @default(true)
  notifyNewOrders     Boolean @default(true)
  soundAlert          Boolean @default(true)
  autoPrintReceipt    Boolean @default(false)
  receiptFooter       String?
  telegramUsername    String?
  telegramBotToken    String?
  telegramChatId      String?
  publicUrl           String?
  fxChannelUsername   String?
  fxKeyword           String?
  fxNumberIndex       Int?
  // Store's physical location — shown to customers via the bot's "📍 Manzilimiz"
  // reply-keyboard button (sent as a native Telegram location, not just text).
  locationLat         Float?
  locationLng         Float?
  customPaymentMethods Json?
  deferredPaymentMethods Json?
  createdAt DateTime @default(now())

  users      User[]
  categories Category[]
  products   Product[]
  customers  Customer[]
  sales      Sale[]
  ledger     LedgerEntry[]
  employees  Employee[]
  orders     OnlineOrder[]
  suppliers  Supplier[]
  settlements ThirdPartySettlement[]
  receipts   GoodsReceipt[]
  handovers  CashHandover[]
  telegramSessions TelegramSession[]
  salaryPayments SalaryPayment[]
  layawayOrders LayawayOrder[]
}

// Per-chat state for the Telegram shopping bot. A bot webhook handles one
// HTTP request per update with no memory of prior messages, so the current
// screen (browsing/checkout step), cart contents, and collected checkout
// details are persisted here between messages.
model TelegramSession {
  id              String   @id @default(cuid())
  storeId         String
  store           Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  chatId          String
  state           String   @default("browsing")
  categoryId      String?
  cart            Json?
  customerName    String?
  customerPhone   String?
  customerAddress String?
  paymentMethod   String?
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@unique([storeId, chatId])
}

model OnlineOrder {
  id              String        @id @default(cuid())
  // Human-friendly sequential order number (1, 2, 3...) shown in the #ID column.
  number          Int           @default(autoincrement())
  storeId         String
  store           Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customerName    String
  customerPhone   String
  customerAddress String?
  items           Json
  total           Int
  paymentMethod   PaymentMethod @default(CASH)
  // Set only when paymentMethod is CUSTOM via "Muddatli to'lov" — the
  // installment plan length (3, 6 or 12 months) the customer picked at checkout.
  installmentMonths Int?
  status          OrderStatus   @default(PENDING)
  source          String        @default("ONLINE")
  saleId          String?       @unique
  sale            Sale?         @relation(fields: [saleId], references: [id])
  courierId       String?
  courier         Employee?     @relation(fields: [courierId], references: [id])
  deliveryDate    DateTime?
  createdAt       DateTime      @default(now())

  @@index([storeId, status])
}

model User {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  login     String   @unique
  password  String
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
}

model Category {
  id       String    @id @default(cuid())
  storeId  String
  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name     String
  products Product[]

  @@unique([storeId, name])
}

model Product {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  name        String
  sku         String
  price       Int
  costPrice   Int      @default(0)
  stock       Int      @default(0)
  lowStockAt  Int      @default(3)
  imageUrl    String?
  images      Json?
  unit         String   @default("dona")
  barcodePrice Int?
  onSale       Boolean  @default(false)
  salePrice    Int?
  // Set for products priced in dollars: the USD/UZS rate their so'm prices
  // were last calculated at. Prices are rescaled whenever the CBU rate moves.
  usdRate      Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  saleItems SaleItem[]
  receipts  GoodsReceipt[]
  layawayOrders LayawayOrder[]

  @@unique([storeId, sku])
  @@index([storeId, name])
}

model Customer {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  phone     String?
  address   String?
  note      String?
  // Set when the customer registered through the Telegram bot.
  telegramChatId String?
  createdAt DateTime @default(now())

  sales  Sale[]
  debts  CreditLedger[]
  layawayOrders LayawayOrder[]

  @@unique([storeId, telegramChatId])
  @@index([storeId, name])
}

model Sale {
  id            String        @id @default(cuid())
  storeId       String
  store         Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customerId    String?
  customer      Customer?     @relation(fields: [customerId], references: [id])
  soldById      String?
  soldBy        Employee?     @relation(fields: [soldById], references: [id], onDelete: SetNull)
  total         Int
  paymentMethod PaymentMethod
  cashAmount    Int           @default(0)
  cardAmount    Int           @default(0)
  creditAmount  Int           @default(0)
  customAmounts Json?
  profit        Int           @default(0)
  canceled      Boolean       @default(false)
  canceledAt    DateTime?
  createdAt     DateTime      @default(now())

  items       SaleItem[]
  creditDebt  CreditLedger?
  ledgerEntry LedgerEntry?
  deliveryOrder OnlineOrder?
  settlements ThirdPartySettlement[]

  @@index([storeId, createdAt])
}

// Tracks money owed to the store by a third-party installment company for a
// sale paid through a payment method flagged as "deferred" in Store.deferredPaymentMethods
// (e.g. a company that pays the customer's purchase on their behalf over several
// working days). The sale's revenue/profit are recognized immediately as usual;
// this amount only joins the Kassa cash/card balance once marked `received`.
model ThirdPartySettlement {
  id             String        @id @default(cuid())
  storeId        String
  store          Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  saleId         String
  sale           Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  methodName     String
  amount         Int
  expectedDate   DateTime
  note           String?
  received       Boolean       @default(false)
  receivedAt     DateTime?
  receivedMethod PaymentMethod?
  createdAt      DateTime      @default(now())

  @@index([storeId, received])
  @@index([saleId])
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  name      String
  qty       Int
  price     Int
  costPrice Int     @default(0)
}

model CreditLedger {
  id          String    @id @default(cuid())
  storeId     String
  saleId      String?   @unique
  sale        Sale?     @relation(fields: [saleId], references: [id])
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id])
  totalAmount Int
  paidAmount  Int       @default(0)
  dueDate     DateTime
  createdAt   DateTime  @default(now())
  payments    CreditPayment[]

  @@index([storeId, dueDate])
}

model CreditPayment {
  id         String       @id @default(cuid())
  ledgerId   String
  ledger     CreditLedger @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  amount     Int
  employeeId String?
  employee   Employee?    @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  note       String?
  createdAt  DateTime     @default(now())
}

model LedgerEntry {
  id          String          @id @default(cuid())
  storeId     String
  store       Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  saleId      String?         @unique
  sale        Sale?           @relation(fields: [saleId], references: [id])
  direction   LedgerDirection
  amount      Int
  method      PaymentMethod   @default(CASH)
  category    String?
  note        String?
  createdAt   DateTime        @default(now())

  @@index([storeId, createdAt])
}

enum HandoverStatus {
  PENDING
  APPROVED
  REJECTED
}

model CashHandover {
  id            String         @id @default(cuid())
  storeId       String
  store         Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  handedOverBy  String
  receivedBy    String
  note          String?
  cashAmount    Int            @default(0)
  cardAmount    Int            @default(0)
  creditAmount  Int            @default(0)
  totalAmount   Int            @default(0)
  status        HandoverStatus @default(PENDING)
  createdAt     DateTime       @default(now())
  decidedAt     DateTime?

  @@index([storeId, status])
}

model Supplier {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  phone     String?
  createdAt DateTime @default(now())

  receipts GoodsReceipt[]
  payments SupplierPayment[]

  @@index([storeId, name])
}

model GoodsReceipt {
  id            String        @id @default(cuid())
  storeId       String
  store         Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  supplierId    String
  supplier      Supplier      @relation(fields: [supplierId], references: [id])
  productId     String?
  product       Product?      @relation(fields: [productId], references: [id])
  productName   String
  qty           Int
  totalCost     Int
  currency      String        @default("som")
  costUsd       Float?
  usdRate       Int?
  paymentMethod PaymentMethod
  paidAmount    Int           @default(0)
  paidUsd       Float         @default(0)
  createdAt     DateTime      @default(now())

  paymentAllocations SupplierPaymentReceipt[]

  @@index([storeId, supplierId])
}

// A single payment made toward a supplier's debt. Linked to the specific
// GoodsReceipt rows it paid off (via SupplierPaymentReceipt) so the purchases
// table can show, per purchase (or per date group), exactly which payments
// were applied to it.
model SupplierPayment {
  id         String        @id @default(cuid())
  storeId    String
  supplierId String
  supplier   Supplier      @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  amount     Int
  method     PaymentMethod @default(CASH)
  paidUsd    Float?
  note       String?
  createdAt  DateTime      @default(now())

  receipts SupplierPaymentReceipt[]

  @@index([storeId, supplierId, createdAt])
}

model SupplierPaymentReceipt {
  id        String          @id @default(cuid())
  paymentId String
  payment   SupplierPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  receiptId String
  receipt   GoodsReceipt    @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  amount    Int

  @@index([receiptId])
}

enum LayawayStatus {
  ACTIVE
  COMPLETED
  DELIVERED
  CANCELED
}

// "Xaqdorlar": a customer pays toward a product's price in installments,
// whenever they have money, and only receives the product once it's paid in
// full. The opposite direction of Nasiya (CreditLedger): there the store gives
// the product first and collects debt after; here the store collects money
// first and hands over the product last.
model LayawayOrder {
  id          String        @id @default(cuid())
  storeId     String
  store       Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Customer      @relation(fields: [customerId], references: [id])
  // Optional link to a real warehouse product (its stock is reserved — decremented —
  // as soon as the order is created, so it can't also be sold at the register).
  // Left null for a custom/one-off item that isn't tracked in Ombor.
  productId   String?
  product     Product?      @relation(fields: [productId], references: [id])
  productName String
  qty         Int           @default(1)
  totalCost   Int
  totalUsd    Float?
  paidAmount  Int           @default(0)
  status      LayawayStatus @default(ACTIVE)
  note        String?
  deliveredAt DateTime?
  canceledAt  DateTime?
  createdAt   DateTime      @default(now())

  payments LayawayPayment[]

  @@index([storeId, status])
  @@index([storeId, customerId])
}

model LayawayPayment {
  id        String        @id @default(cuid())
  orderId   String
  order     LayawayOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount    Int
  method    PaymentMethod @default(CASH)
  note      String?
  createdAt DateTime      @default(now())

  @@index([orderId])
}

model Employee {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  phone     String?
  position  String?
  salary    Int      @default(0)
  salaryType SalaryType @default(MONTHLY)
  login       String?
  passwordHash String?
  isCourier   Boolean  @default(false)
  photoUrl    String?
  faceDescriptor String?
  allowedLocationName String?
  allowedLat          Float?
  allowedLng          Float?
  allowedRadius       Int?    @default(100)
  workStartTime       String?
  workEndTime         String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  attendance Attendance[]
  deliveries OnlineOrder[]
  sales      Sale[]
  creditPayments CreditPayment[]
  salaryPayments SalaryPayment[]
}

model Attendance {
  id         String           @id @default(cuid())
  employeeId String
  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime
  status     AttendanceStatus
  checkIn    DateTime?
  checkOut   DateTime?
  checkInLat Float?
  checkInLng Float?
  withinRange Boolean?
  faceVerified Boolean?

  @@unique([employeeId, date])
}

// A salary payout to an employee. Also recorded as a LedgerEntry (OUT,
// category "Oylik") so it shows up in Moliya.
model SalaryPayment {
  id            String        @id @default(cuid())
  storeId       String
  store         Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  employeeId    String
  employee      Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  amount        Int
  method        PaymentMethod @default(CASH)
  note          String?
  ledgerEntryId String?
  createdAt     DateTime      @default(now())

  @@index([storeId, employeeId, createdAt])
}
